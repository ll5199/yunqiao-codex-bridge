// 云桥智能路由中文注释模板
//
// 重要：本文件用于阅读和修改参考，客户端不会读取它。
// 真正生效的文件是同目录下的 routing-policy.json。
// JSON 标准不允许注释，因此修改完成后要删除所有 // 注释，再覆盖正式文件。
{
  // 配置结构版本。当前客户端只支持 1，请勿修改。
  "schema_version": 1,

  // 本次策略版本名称。每次修改正式配置时都必须换成新的值。
  // 推荐格式：年-月-日.当天修改次数，例如 2026-09-09.2。
  // 客户端日志会记录这个值，方便确认新策略是否已经生效。
  "policy_version": "2026-09-09.1",

  // 客户端自动检查新配置的间隔，单位为秒。
  // 允许范围：60～3600。300 表示每 5 分钟检查一次。
  // 如果想立即生效，可以保存正式配置后重启云桥客户端。
  "refresh_seconds": 300,

  // 默认路由：任务没有命中任何明确规则，且智能分类不可用时使用。
  "default": {
    // 默认执行模型。当前设置为 Grok，适合普通查找、修改和操作任务。
    "model": "grok-4.6",

    // 默认推理强度：low、medium、high；Grok 还允许 xhigh。
    // low 响应更快、成本更低，适合大量日常操作。
    "effort": "low"
  },

  // 固定规则列表。客户端从上到下检查所有规则，命中多个时优先级高者在前。
  // 一条规则内的文字长度、附件数、match_any、match_all_groups 是“任一满足即可命中”。
  "rules": [
    {
      // 规则内部名称：只用于日志，不显示给用户。
      // 只能使用小写英文字母、数字、下划线或短横线，而且不能重复。
      "reason": "routine_file_operation",

      // 命中本规则后交给 Grok 4.6 执行。
      "model": "grok-4.6",

      // Grok 使用 low，减少查找、替换、上传等任务开始前的等待。
      "effort": "low",

      // 规则优先级，数字越大越优先。
      // 这里设为 100，是为了让“批量替换”等操作优先于结构化批处理。
      "priority": 100,

      // 任意关键词：用户任务中只要包含其中一个词，就命中本规则。
      // 可以直接增加或删除词语；建议同时保留常用中文和英文表达。
      "match_any": [
        "查找替换",
        "查找并替换",
        "批量替换",
        "复制粘贴",
        "替换公司名称",
        "修改公司名称",
        "替换日期",
        "调整格式",
        "统一格式",
        "整理目录",
        "重命名文件",
        "查找文件",
        "搜索文件",
        "打开文件",
        "上传文件",
        "批量上传",
        "上传网站",
        "find and replace",
        "copy and paste",
        "rename file",
        "find file",
        "upload files"
      ]
    },
    {
      // 结构化整理、字段提取、表格和 OCR 规则。
      "reason": "structured_batch",

      // 命中后由 Luna 执行。Luna 适合格式明确、重复度高的结构化任务。
      "model": "gpt-5.6-luna",

      // medium 兼顾处理准确度和速度。需要更快可改 low，需要更仔细可改 high。
      "effort": "medium",

      // 低于日常文件操作，避免“批量替换”被误分给 Luna。
      "priority": 90,

      // 添加新业务关键词时直接在数组中增加一行，注意上一行末尾要有英文逗号。
      "match_any": [
        "字段提取",
        "提取字段",
        "分类整理",
        "输出表格",
        "格式转换",
        "结构化",
        "生成清单",
        "去重",
        "图片识别文字",
        "图片转文字",
        "文字识别",
        "扫描件识别",
        "field mapping",
        "extract fields",
        "categorize",
        "schema",
        "ocr"
      ]
    },
    {
      // 大量文件、超长内容和跨文档综合规则。
      "reason": "large_multi_document",

      // 命中后由 Terra 执行，适合长上下文、多文件和 OCR 综合处理。
      "model": "gpt-5.6-terra",

      // 默认 medium。若主要是机械读取可改 low；复杂综合分析可改 high。
      "effort": "medium",

      "priority": 80,

      // 用户输入累计达到多少字符时命中。700000 表示约 70 万字符。
      // 设为 0 表示关闭“文字长度”这个条件。
      "min_text_chars": 700000,

      // 用户一次附加多少个文件时命中。6 表示 6 个及以上附件。
      // 设为 0 表示关闭“附件数量”这个条件。
      "min_file_count": 6,

      // 即使字符数和附件数未达到阈值，包含下列任一关键词也会命中。
      "match_any": [
        "整个文件夹",
        "全部文件",
        "多份文档",
        "跨文档",
        "交叉分析",
        "长文档",
        "综合多份",
        "entire folder",
        "multiple documents",
        "cross-document",
        "long document"
      ]
    },
    {
      // 复杂工程标书撰写和深度重写规则。
      "reason": "complex_bid_drafting",

      // 命中后由 Sol 执行。Sol 用于真正需要写作和推理的复杂章节。
      "model": "gpt-5.6-sol",

      // high 提高复杂标书内容的完整度。日常任务不要使用本规则。
      "effort": "high",

      "priority": 70,

      // 下列强特征词只需出现一个，就直接命中 Sol。
      "match_any": [
        "复杂改写",
        "深度重写",
        "评分点响应",
        "逐条响应",
        "complex rewrite",
        "scoring point response"
      ],

      // 组合关键词组：每个子数组至少命中一个词，整项才算满足。
      // 当前第一组是“撰写动作”，第二组是“复杂标书主题”。
      // 例如同时出现“编写”+“施工组织设计”才会命中；只提到技术方案不会命中。
      "match_all_groups": [
        [
          "撰写",
          "编写",
          "起草",
          "重写",
          "改写",
          "扩写",
          "润色",
          "优化",
          "生成",
          "制定",
          "完善",
          "draft",
          "write",
          "rewrite"
        ],
        [
          "施工组织设计",
          "技术方案",
          "施工方案",
          "实施方案",
          "技术标",
          "质量保证措施",
          "安全保证措施",
          "应急预案",
          "项目重点",
          "项目难点",
          "评分标准",
          "响应内容",
          "technical proposal",
          "implementation plan",
          "quality assurance plan",
          "scoring criteria"
        ]
      ]
    }
  ],

  // 智能分类器：任务不明确或同时像多种任务时，先让一个便宜模型判断执行模型。
  "classifier": {
    // true 为启用；false 为完全关闭模型判断，只使用固定规则和默认路由。
    "enabled": true,

    // 负责“理解任务并分配模型”的模型。当前使用 Luna，成本较低。
    "model": "gpt-5.6-luna",

    // 分类只需理解短任务说明，所以建议保持 low。
    "effort": "low",

    // 分类结果最低可信度，范围 0.50～0.99。
    // 0.75 表示可信度达到 75% 才采用分类器选择的模型。
    "confidence_threshold": 0.75,

    // 分类请求最多等待多少秒，允许 1～15。
    // 超时后自动退回固定规则，不会阻断正式任务。
    "timeout_seconds": 8,

    // 最多发送多少个任务说明字符给分类器，允许 256～8000。
    // 这里只发送用户任务说明和附件数量，不发送附件正文。
    "max_input_chars": 4000,

    // 分类可信度低于上方阈值时使用的兜底执行模型。
    "low_confidence": {
      // Terra 对不明确、多文档任务更稳妥。
      "model": "gpt-5.6-terra",
      "effort": "medium"
    }
  },

  // 模糊任务的比例分配。它只影响无法明确判断的任务，不覆盖明确关键词规则。
  "ambiguous_distribution": {
    // false：不启用比例，低可信度统一走 classifier.low_confidence。
    // true：启用下面的权重，根据会话稳定分配；同一任务中途不会随机换模型。
    "enabled": false,

    // 权重不要求总和等于 100，客户端按相对比例计算。
    // 例如 70/15/10/5 就约等于 Grok 70%、Terra 15%、Luna 10%、Sol 5%。
    // 若不希望某模型接收模糊任务，将它的权重改为 0。
    "weights": {
      "grok-4.6": 70,
      "gpt-5.6-terra": 15,
      "gpt-5.6-luna": 10,
      "gpt-5.6-sol": 5
    }
  }
}
